        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"user_email\": \"user@example.com\",\n    \"device_id\": \"device_uuid_1\"\n}"
        },
        "description": "Deactivate a specific device by device_id. Only that device stops receiving notifications; other devices remain active."
      }
    },
