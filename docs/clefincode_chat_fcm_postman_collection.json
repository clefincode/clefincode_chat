      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base_url}}/api/method/clefincode_chat.api.api_1_3_4.api.remove_registration_token",
          "host": ["{{base_url}}"],
          "path": ["api", "method", "clefincode_chat.api.api_1_3_4.api.remove_registration_token"]
